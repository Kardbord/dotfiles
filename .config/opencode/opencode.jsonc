{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "https://raw.githubusercontent.com/Kardbord/dotfiles/refs/heads/master/.config/opencode/AGENTS.md",
  ],
  "enabled_providers": [
    "openrouter"
  ],
  "mcp": {
    // File system navigation, search, etc.
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "@modelcontextprotocol/server-filesystem",
        "./",
      ],
      "enabled": true,
    },
    // Git commands
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "mcp-server-git"
      ],
      "enabled": true,
    },
    // Bruno collections management (Postman Replacement)
    "bruno": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "@ostico/bruno-mcp",
      ],
      "enabled": true,
    },
    // Composio is an MCP gateway which manages oauth
    // to other MCP servers via web portal. It is my
    // primary provider for remote MCP. Piece-meal
    // MCP servers are configured below in case I
    // hit my free Composio usage limit, but
    // disabled by default.
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "headers": {
        "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      },
      "enabled": true,
    },
    // Web search and fetch.
    // Exa has a keyless free tier.
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": false
    },
    // Documentation references.
    // Has a keyless free tier.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    // GitHub integration
    "github": {
      "type": "local",
      "command": [
        "go",
        "run",
        "github.com/github/github-mcp-server/cmd/github-mcp-server@latest",
        "stdio",
        "--read-only",
        "--toolsets",
        "actions,git,context,repos,issues,pull_requests"
      ],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GOPATH": "{env:XDG_DATA_HOME}/go",
        "GOMODCACHE": "{env:XDG_DATA_HOME}/go/pkg/mod",
        "GOCACHE": "{env:XDG_CACHE_HOME}/go-build"
      }
    }
  },
  "provider": {
    "openrouter": {
      "whitelist": [
        // Routers
        "openrouter/auto-beta",
        "openrouter/free",
        "openrouter/fusion",
        "openrouter/fusion-flash",
        "openrouter/fusion-flash:free",
        "openrouter/fusion:free",
        "openrouter/pareto-code",
        // Latest and greatest
        "~anthropic/claude-fable-latest",
        "~anthropic/claude-haiku-latest",
        "~anthropic/claude-opus-latest",
        "~anthropic/claude-sonnet-latest",
        "~google/gemini-flash-latest",
        "~google/gemini-pro-latest",
        "~moonshotai/kimi-latest",
        // Explicit models
        "cohere/north-mini-code:free",
        "~deepseek/deepseek-v4-flash-latest",
        "deepseek/deepseek-v4-pro",
        "google/gemini-3.5-flash-lite",
        "google/gemma-4-26b-a4b-it",
        "google/gemma-4-31b-it",
        "ibm-granite/granite-4.1-8b",
        "inception/mercury-2",
        "inclusionai/ling-3.0-flash:free",
        "inclusionai/ring-2.6-1t",
        "kwaipilot/kat-coder-air-v2.5",
        "minimax/minimax-m3",
        "mistralai/mistral-small-2603",
        "moonshotai/kimi-k2.7-code",
        "moonshotai/kimi-k3",
        "nex-agi/nex-n2-pro",
        "nvidia/nemotron-3-super-120b-a12b",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "poolside/laguna-s-2.1",
        "qwen/qwen3-coder-next",
        "qwen/qwen3.7-flash",
        "qwen/qwen3.7-plus",
        "tencent/hy3",
        "xiaomi/mimo-v2.5-pro",
        "z-ai/glm-5.2",
      ],
      "models": {
        "openrouter/auto-beta": {
          "options": {
            "plugins": [
              {
                "id": "auto-router",
                "cost_tier": "high",
                "allowed_models": [
                  "deepseek/*",
                  "google/gemma-*",
                  "inception/mercury-2",
                  "minimax/*",
                  "mistralai/code*",
                  "mistralai/mistral-small*",
                  "moonshotai/*",
                  "qwen/*",
                  "xiaomi/*",
                  "z-ai/*",
                ]
              }
            ]
          }
        },
        "openrouter/pareto-code": {
          "options": {
            "plugins": [
              {
                "id": "pareto-router",
                "min_coding_score": 0.33
              }
            ]
          }
        },
        "openrouter/fusion": {
          "options": {
            "plugins": [
              {
                "id": "fusion",
                "analysis_models": [
                  // 8 models max
                  "cohere/north-mini-code:free",
                  "~deepseek/deepseek-v4-flash-latest",
                  "google/gemma-4-26b-a4b-it:free",
                  "inclusionai/ling-3.0-flash:free",
                  "nvidia/nemotron-3-ultra-550b-a55b:free",
                  "poolside/laguna-s-2.1",
                  "tencent/hy3-preview",
                  "xiaomi/mimo-v2.5",
                ],
                "model": "~deepseek/deepseek-v4-flash-latest",
                "max_tool_calls": 8 // 16 tool calls max
              }
            ]
          }
        },
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "model": "openrouter/~deepseek/deepseek-v4-flash-latest",
  "small_model": "openrouter/openrouter/free",
  "logLevel": "WARN",
  "autoupdate": true,
  "snapshot": true,
  "formatter": true,
  "lsp": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "tools": {
    "bash": false,
  },
  "permission": {
    // Default to asking
    "*": "ask",
    // filesystem MCP
    // NOTE: this MCP server is scoped to the CWD
    "filesystem_*": "allow",
    // Composio MCP
    "composio_*": "allow",
    // Github MCP
    // NOTE: this is acceptable only because we are running the github mcp server in read-only mode
    "github_*": "allow",
    // Exa MCP
    "exa_*": "allow",
    // Context7 MCP
    "context7_*": "allow",
    // Bruno MCP
    "bruno_set_environment_variable": "ask",
    "bruno_run_collection": "ask",
    "bruno_*": "allow",
    // Git MCP
    "git_git_status": "allow",
    "git_git_diff*": "allow",
    "git_git_log": "allow",
    "git_git_show": "allow",
    "git_git_branch": "allow",
    // OpenCode built-ins
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env*": "deny",
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "ask",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "repo_clone": "ask",
    "repo_overview": "ask",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "bash": "deny",
  }
}
