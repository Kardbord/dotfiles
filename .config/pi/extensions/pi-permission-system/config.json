    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.p12": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "~/.ssh/*": "deny",
      "auth.json": "deny",
      "mcp-auth.json": "deny",
      "models-store.json": "deny",
      "sessions/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/app/lib/kardbord-tools/pi/": "allow",
      "~/.config/pi": "allow",
      "~/.pi": "allow"
    }
  }
