{
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "ask",
    "actionlint": "allow",
    "ask_user_question": "allow",
    "bash": "deny",
    "codemode": "allow",
    "edit": "allow",
    "fd": "allow",
    "go_build": "allow",
    "go_format": "allow",
    "go_help": "allow",
    "go_lint": "allow",
    "go_mod": "allow",
    "go_test": "allow",
    "grep": "allow",
    "jq": "allow",
    "lens_diagnostics": "allow",
    "ls": "allow",
    "read": "allow",
    "review": "allow",
    "subagent": "allow",
    "subagent_supervisor": "allow",
    "subagents_enable": "allow",
    "todo": "allow",
    "tool_search": "allow",
    "write": "allow",
    "yq": "allow",
    "mcp": {
      "*": "ask",
      "context7": "allow",
      "exa": "allow",
      "filesystem": "allow",
      "git": "ask",
      "git_status": "allow",
      "git_log": "allow",
      "git_show": "allow",
      "git_diff*": "allow",
      "git_fetch": "allow",
      "github": "allow",
      "git_add": "ask",
      "git_checkout": "ask",
      "git_commit": "ask",
      "git_create_branch": "ask",
      "git_merge": "ask",
      "git_reset": "ask"
